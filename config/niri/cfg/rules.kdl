overview {
  workspace-shadow {
    on
  }
}

gestures {
  hot-corners {
    off
  }
}

window-rule {
  geometry-corner-radius 0
  clip-to-geometry true
}

layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}

cursor {
  xcursor-size 24
  xcursor-theme "Banana"
}

layout {
  gaps 4
  background-color "transparent"

  focus-ring {
    off
  }

  insert-hint {
    color "#ffffff"
  }

  preset-window-heights {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  border {
    on
    active-color   "#b2b2b2"
    inactive-color "#000000"
    urgent-color   "#ffb4ab"
    width 1
  }

  tab-indicator {
    place-within-column
    length total-proportion=1.0
    width 6
    gap 0
    position       "top"
    active-color   "#b2b2b2"
    inactive-color "#000000"
    urgent-color   "#ffb4ab"
  }

}

animations {
  off
  slowdown 0.8
  window-open {
    duration-ms 100
    curve "ease-out-expo"
  }
  window-close {
    duration-ms 100
    curve "ease-out-quad"
  }
}

