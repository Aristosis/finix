spawn-sh-at-startup "kitty --start-as=hidden --single-instance -1" // headless kitty lmao
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-sh-at-startup "awww-daemon"   // Wallpaper daemon

spawn-sh-at-startup "
    pipewire &

    until [ -S \"$XDG_RUNTIME_DIR/pipewire-0\" ]; do
      sleep 0.1
    done

    wireplumber &
    pipewire-pulse &
"
